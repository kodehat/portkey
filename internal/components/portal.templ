package components

import "github.com/kodehat/portkey/internal/models"

templ HomePortalWithToolTip(portal models.Portal) {
	if len(portal.Keywords) == 0 {
		@HomePortal(portal)
	} else {
		<div class="relative group">
			@HomePortal(portal)
			<div class="hidden group-hover:flex absolute z-10 top-full left-0 mt-1 flex-wrap gap-1.5 px-2 py-1.5 rounded-lg bg-black/70 backdrop-blur-md shadow-xl border border-white/10">
				for _, keyword := range portal.Keywords {
					@tooltip(keyword)
				}
			</div>
		</div>
	}
}

templ tooltip(keyword string) {
	<span class="inline-flex items-center rounded-md bg-white/8 text-white/50 px-2 py-0.5 text-xs font-normal">
		{ keyword }
	</span>
}

templ HomePortal(portal models.Portal) {
	<a
		if portal.IsExternal() {
			target="_blank"
			rel="nofollow"
		}
		if portal.IsExternal() {
			href={ templ.SafeURL("/" + portal.TitleForUrl()) }
		} else {
			href={ templ.SafeURL(portal.Link) }
		}
		class="flex items-center gap-2.5 px-3 py-2 rounded-lg border border-transparent bg-white/5 hover:bg-white/10 hover:border-white/12 transition-all duration-150 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white/30"
	>
		<span class="shrink-0 w-4 h-4 flex items-center justify-center opacity-70">
			if portal.Icon != "" && isIconImage(portal.Icon) {
				<img src={ templ.SafeURL(portal.Icon) } alt="" class="w-4 h-4 rounded"/>
			} else if portal.Icon != "" {
				<span class="text-sm">{ portal.Icon }</span>
			} else if portal.IsExternal() {
				<img
					src={ templ.SafeURL(faviconURL(portal.Link)) }
					alt=""
					class="w-4 h-4 rounded"
					onerror="this.style.display='none';var fb=this.parentNode.querySelector('.fav-fb');if(fb)fb.classList.remove('hidden');"
				/>
				<svg class="fav-fb hidden w-3.5 h-3.5 text-white/30" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
					<path d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636"/>
				</svg>
			} else {
				<svg class="w-3.5 h-3.5 text-white/30" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
					<path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
					<path d="M14 3v4a1 1 0 0 0 1 1h4"></path>
					<path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z"></path>
					<path d="M9 9l1 0"></path>
					<path d="M9 13l6 0"></path>
					<path d="M9 17l6 0"></path>
				</svg>
			}
		</span>
		<span class="flex-1 min-w-0 text-white/80 font-normal">
			<span class="truncate block">{ portal.Title }</span>
		</span>
		if portal.IsExternal() {
			<span class="shrink-0 text-xs text-white/25 truncate max-w-[110px] text-right">
				{ domainFromURL(portal.Link) }
			</span>
		}
	</a>
}

templ FooterPortal(portal models.Portal) {
	<span class="inline-flex items-center gap-1 mx-2 text-sm">
		if portal.Icon != "" {
			if isIconImage(portal.Icon) {
				<img src={ templ.SafeURL(portal.Icon) } alt="" class="w-4 h-4"/>
			} else {
				{ portal.Icon }
			}
		}
		<a
			if portal.IsExternal() {
				target="_blank"
				rel="nofollow"
			}
			if portal.IsExternal() {
				href={ templ.SafeURL("/" + portal.TitleForUrl()) }
			} else {
				href={ templ.SafeURL(portal.Link) }
			}
			class="text-white/30 hover:text-white/60 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white/30 rounded-sm"
		>{ portal.Title }</a>
	</span>
}
