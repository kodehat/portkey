package components

import (
	"fmt"
	"github.com/kodehat/portkey/internal/build"
	"github.com/kodehat/portkey/internal/config"
)

templ Base(pageTitle string, config config.Config, buildDetails build.BuildDetails) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<!-- === portkey === -->
		@templ.Raw(fmt.Sprintf("<!-- build time: %s -->", build.BuildTime))
		if buildDetails.CommitHash != "" {
			@templ.Raw(fmt.Sprintf("<!-- commit hash: %s -->", build.CommitHash))
		}
		@templ.Raw(fmt.Sprintf("<!-- version: %s -->", build.Version))
		@templ.Raw(fmt.Sprintf("<!-- go version: %s -->", build.GoVersion))
		<head>
			<!-- Basics -->
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<!-- Favicon stuff -->
			<link rel="apple-touch-icon" sizes="180x180" href={ config.Server.ContextPath + "/static/img/apple-touch-icon.png" }/>
			<link rel="icon" type="image/png" sizes="32x32" href={ config.Server.ContextPath + "/static/img/favicon-32x32.png" }/>
			<link rel="icon" type="image/png" sizes="16x16" href={ config.Server.ContextPath + "/static/img/favicon-16x16.png" }/>
			<link rel="manifest" href={ config.Server.ContextPath + "/static/img/site.webmanifest" }/>
			<link rel="shortcut icon" href={ config.Server.ContextPath + "/static/img/favicon.ico" }/>
			<!-- Theme -->
			<meta name="theme-color" content="#0a0a0a"/>
			<!-- Stylesheets -->
			<link href={ config.Server.ContextPath + "/static/css/main.css?hash=" + buildDetails.CssHash } rel="stylesheet"/>
			<!-- Deferred JavaScript -->
			<script defer src={ config.Server.ContextPath + "/static/js/main.js" }></script>
			if config.Server.DevMode {
				@DevModeSnippet(config.Server.ContextPath)
			}
			<!-- Set title -->
			<title>
				if config.UI.Title != "" {
					{ pageTitle } - { config.UI.Title }
				} else {
					{ pageTitle }
				}
			</title>
			if config.UI.HeaderAddition != "" {
				<!-- Header addition -->
				@templ.Raw(config.UI.HeaderAddition)
			}
		</head>
		<body class="text-slate-200 text-sm m-0 p-0 leading-normal min-h-screen flex flex-col">
			<!-- Top bar -->
			<div class="flex items-center justify-between px-5 py-3 border-b border-white/8 bg-black/30 backdrop-blur-md">
				<div class="flex items-center gap-2.5">
					if config.UI.ShowTopIcon {
						<a href={ templ.SafeURL(config.Server.ContextPath + "/") } class="flex items-center gap-2.5 no-underline">
							<img class="w-6 h-6 rounded-full opacity-80" src={ config.Server.ContextPath + "/static/img/android-chrome-512x512.png" } alt="logo"/>
							if config.UI.Title != "" {
								<span class="text-sm font-medium text-white/70 tracking-wide">{ config.UI.Title }</span>
							}
						</a>
					} else if config.UI.Title != "" {
						<a href={ templ.SafeURL(config.Server.ContextPath + "/") } class="text-sm font-medium text-white/70 tracking-wide no-underline hover:text-white/90 transition-colors">{ config.UI.Title }</a>
					}
				</div>
			</div>
			{ children... }
		</body>
	</html>
}

templ HomeLayout(pageTitle string, config config.Config, buildDetails build.BuildDetails, searchBar templ.Component, results templ.Component) {
	@Base(pageTitle, config, buildDetails) {
		<nav class="flex-1 flex flex-col items-center px-4 max-w-5xl mx-auto w-full">
			<div class="flex flex-col items-center w-full mt-14 md:mt-28">
				@searchBar
			</div>
			<div class="flex flex-col items-center w-full">
				@results
			</div>
			<div class="flex-1 min-h-4"></div>
		</nav>
		<footer class="w-full flex justify-center text-center px-4 pb-3 text-[10px] text-white/25">
			@templ.Raw(config.UI.Footer)
		</footer>
	}
}

templ ContentLayout(pageTitle string, config config.Config, buildDetails build.BuildDetails, contents templ.Component) {
	@Base(pageTitle, config, buildDetails) {
		<div class="flex-1 flex flex-col max-w-2xl mx-auto px-4 w-full">
			<div class="flex flex-col mt-12 md:mt-24 pb-12">
				<header class="mb-5">
					<a href={ templ.SafeURL(config.Server.ContextPath + "/") } class="inline-flex items-center gap-1.5 text-xs text-white/40 hover:text-white/70 transition-colors mb-3 rounded-md px-1.5 py-0.5 -ml-1.5 hover:bg-white/8" title="Back to home">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
							<path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
							<path d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3"></path>
						</svg>
						<span>Back</span>
					</a>
					<h2 class="text-lg md:text-xl font-semibold text-white/90">{ pageTitle }</h2>
				</header>
				<article class="bg-white/6 backdrop-blur-md rounded-xl border border-white/10 p-4 md:p-6 leading-relaxed text-sm text-white/75 shadow-xl">
					@contents
				</article>
				<div class="mt-8 pt-5 border-t border-white/8">
					<p class="text-xs font-medium tracking-wider uppercase text-white/30 mb-3">Links</p>
					<nav class="flex flex-col gap-1.5 w-full opacity-80">
						for _, portal := range config.Portals {
							@HomePortal(portal)
						}
					</nav>
				</div>
			</div>
		</div>
		<footer class="w-full flex justify-center text-center px-4 pb-3 text-[10px] text-white/25">
			@templ.Raw(config.UI.Footer)
		</footer>
	}
}
