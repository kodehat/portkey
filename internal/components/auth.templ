package components

import (
	"github.com/kodehat/portkey/internal/build"
	"github.com/kodehat/portkey/internal/config"
)

templ authBase(conf config.Config, b build.BuildDetails) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="theme-color" content="#0a0a0a"/>
			<title>AM-links</title>
			<link href={ conf.Server.ContextPath + "/static/css/main.css?hash=" + b.CssHash } rel="stylesheet"/>
		</head>
		<body class="text-slate-200 text-sm m-0 p-0 leading-normal">
			<div class="min-h-screen flex items-center justify-center px-4">
				{ children... }
			</div>
		</body>
	</html>
}

templ LoginPage(conf config.Config, b build.BuildDetails, showRegLink bool) {
	@authBase(conf, b) {
		<div id="auth-root" data-cp={ conf.Server.ContextPath } class="bg-black/40 backdrop-blur-xl rounded-2xl border border-white/10 p-8 w-full max-w-sm shadow-[0_8px_48px_rgba(0,0,0,0.7)]">
			<div class="mb-8">
				<h1 class="text-white/90 text-2xl font-semibold tracking-tight mb-1">AM-links</h1>
				<p class="text-white/40 text-xs">Authenticate with your passkey to continue</p>
			</div>
			<button
				id="loginBtn"
				class="w-full flex items-center justify-center gap-2.5 px-4 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 active:bg-white/8 border border-white/12 text-white/85 text-sm font-medium transition-all duration-150 cursor-pointer"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M12 10a2 2 0 0 1 2 2c0 1.5-.5 3-1.5 4"></path>
					<path d="M12 10a4 4 0 0 0-4 4c0 2.5 1 5 2 6.5"></path>
					<path d="M12 10V7"></path>
					<path d="M9 7a3 3 0 0 1 6 0"></path>
					<path d="M12 4a6 6 0 0 0-6 6c0 4 2 7 3 9"></path>
					<path d="M17 10a5 5 0 0 0-5-5"></path>
					<path d="M17 10c0 3-1 6-2.5 8"></path>
				</svg>
				Sign in with passkey
			</button>
			<p id="authError" class="mt-3 text-red-400/80 text-xs text-center" style="display:none"></p>
			if showRegLink {
				<div class="mt-6 pt-5 border-t border-white/8 text-center">
					<a href={ templ.SafeURL(conf.Server.ContextPath + "/auth/register") } class="text-white/30 hover:text-white/60 text-xs transition-colors">
						No passkey yet? Register one →
					</a>
				</div>
			}
		</div>
		<script>
		(function() {
		  var root = document.getElementById('auth-root');
		  var cp = root ? root.dataset.cp : '';
		  var btn = document.getElementById('loginBtn');
		  var err = document.getElementById('authError');

		  function showErr(msg) { err.textContent = msg; err.style.display = 'block'; }

		  var b64 = {
		    decode: function(s) {
		      s = s.replace(/-/g, '+').replace(/_/g, '/');
		      s += '='.repeat((4 - s.length % 4) % 4);
		      return Uint8Array.from(atob(s), function(c) { return c.charCodeAt(0); }).buffer;
		    },
		    encode: function(buf) {
		      return btoa(String.fromCharCode.apply(null, new Uint8Array(buf)))
		        .replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
		    }
		  };

		  if (!window.PublicKeyCredential) {
		    btn.textContent = 'Passkeys not supported in this browser';
		    btn.disabled = true;
		    return;
		  }

		  btn.addEventListener('click', function() {
		    btn.disabled = true;
		    btn.textContent = 'Waiting…';
		    err.style.display = 'none';

		    fetch(cp + '/auth/begin', { method: 'POST' })
		      .then(function(r) { return r.ok ? r.json() : r.text().then(function(t) { throw new Error(t); }); })
		      .then(function(opts) {
		        opts.publicKey.challenge = b64.decode(opts.publicKey.challenge);
		        if (opts.publicKey.allowCredentials) {
		          opts.publicKey.allowCredentials = opts.publicKey.allowCredentials.map(function(c) {
		            return Object.assign({}, c, { id: b64.decode(c.id) });
		          });
		        }
		        return navigator.credentials.get(opts);
		      })
		      .then(function(cred) {
		        var body = {
		          id: cred.id,
		          rawId: b64.encode(cred.rawId),
		          type: cred.type,
		          response: {
		            clientDataJSON: b64.encode(cred.response.clientDataJSON),
		            authenticatorData: b64.encode(cred.response.authenticatorData),
		            signature: b64.encode(cred.response.signature),
		            userHandle: cred.response.userHandle ? b64.encode(cred.response.userHandle) : null
		          }
		        };
		        return fetch(cp + '/auth/finish', {
		          method: 'POST',
		          headers: { 'Content-Type': 'application/json' },
		          body: JSON.stringify(body)
		        });
		      })
		      .then(function(r) {
		        if (!r.ok) throw new Error('Authentication failed');
		        window.location.href = cp + '/';
		      })
		      .catch(function(e) {
		        if (e && e.name !== 'NotAllowedError') showErr(e.message || 'Authentication failed');
		        btn.disabled = false;
		        btn.textContent = 'Sign in with passkey';
		      });
		  });
		})();
		</script>
	}
}

templ RegisterPage(conf config.Config, b build.BuildDetails) {
	@authBase(conf, b) {
		<div id="auth-root" data-cp={ conf.Server.ContextPath } class="bg-black/40 backdrop-blur-xl rounded-2xl border border-white/10 p-8 w-full max-w-sm shadow-[0_8px_48px_rgba(0,0,0,0.7)]">
			<div class="mb-8">
				<a href={ templ.SafeURL(conf.Server.ContextPath + "/auth") } class="inline-flex items-center gap-1.5 text-xs text-white/30 hover:text-white/60 transition-colors mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="M19 12H5m0 0 7 7m-7-7 7-7"></path>
					</svg>
					Back
				</a>
				<h1 class="text-white/90 text-2xl font-semibold tracking-tight mb-1">Register passkey</h1>
				<p class="text-white/40 text-xs">Your Face ID or Touch ID will unlock this page</p>
			</div>
			<button
				id="regBtn"
				class="w-full flex items-center justify-center gap-2.5 px-4 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 active:bg-white/8 border border-white/12 text-white/85 text-sm font-medium transition-all duration-150 cursor-pointer"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
					<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
					<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
				</svg>
				Register with biometrics
			</button>
			<p id="regError" class="mt-3 text-red-400/80 text-xs text-center" style="display:none"></p>
			<p id="regSuccess" class="mt-3 text-green-400/80 text-xs text-center" style="display:none">Passkey registered — redirecting…</p>
		</div>
		<script>
		(function() {
		  var root = document.getElementById('auth-root');
		  var cp = root ? root.dataset.cp : '';
		  var btn = document.getElementById('regBtn');
		  var err = document.getElementById('regError');
		  var ok = document.getElementById('regSuccess');

		  function showErr(msg) { err.textContent = msg; err.style.display = 'block'; }

		  var b64 = {
		    decode: function(s) {
		      s = s.replace(/-/g, '+').replace(/_/g, '/');
		      s += '='.repeat((4 - s.length % 4) % 4);
		      return Uint8Array.from(atob(s), function(c) { return c.charCodeAt(0); }).buffer;
		    },
		    encode: function(buf) {
		      return btoa(String.fromCharCode.apply(null, new Uint8Array(buf)))
		        .replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
		    }
		  };

		  if (!window.PublicKeyCredential) {
		    btn.textContent = 'Passkeys not supported';
		    btn.disabled = true;
		    return;
		  }

		  btn.addEventListener('click', function() {
		    btn.disabled = true;
		    btn.textContent = 'Waiting…';
		    err.style.display = 'none';

		    fetch(cp + '/auth/register/begin', { method: 'POST' })
		      .then(function(r) { return r.ok ? r.json() : r.text().then(function(t) { throw new Error(t); }); })
		      .then(function(opts) {
		        opts.publicKey.challenge = b64.decode(opts.publicKey.challenge);
		        opts.publicKey.user.id = b64.decode(opts.publicKey.user.id);
		        if (opts.publicKey.excludeCredentials) {
		          opts.publicKey.excludeCredentials = opts.publicKey.excludeCredentials.map(function(c) {
		            return Object.assign({}, c, { id: b64.decode(c.id) });
		          });
		        }
		        return navigator.credentials.create(opts);
		      })
		      .then(function(cred) {
		        var body = {
		          id: cred.id,
		          rawId: b64.encode(cred.rawId),
		          type: cred.type,
		          response: {
		            clientDataJSON: b64.encode(cred.response.clientDataJSON),
		            attestationObject: b64.encode(cred.response.attestationObject)
		          }
		        };
		        return fetch(cp + '/auth/register/finish', {
		          method: 'POST',
		          headers: { 'Content-Type': 'application/json' },
		          body: JSON.stringify(body)
		        });
		      })
		      .then(function(r) {
		        if (!r.ok) return r.text().then(function(t) { throw new Error(t); });
		        ok.style.display = 'block';
		        setTimeout(function() { window.location.href = cp + '/auth'; }, 1500);
		      })
		      .catch(function(e) {
		        if (e && e.name !== 'NotAllowedError') showErr(e.message || 'Registration failed');
		        btn.disabled = false;
		        btn.textContent = 'Register with biometrics';
		      });
		  });
		})();
		</script>
	}
}
